<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.zugar.controller.CatalogController"
      spacing="16" styleClass="root">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="Peer-to-Peer Rental Marketplace" styleClass="title-label"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search items (e.g. camera, laptop)..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter" prefWidth="160"/>
        <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Available Rentals &amp; Access Requests" styleClass="section-label"/>
        <ListView fx:id="itemsListView" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
