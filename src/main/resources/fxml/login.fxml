<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.zugar.controller.LoginController"
      alignment="CENTER" spacing="16" styleClass="root">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <VBox styleClass="card" maxWidth="400" spacing="14" alignment="CENTER_LEFT">
        <Label text="Welcome to Zugar" styleClass="title-label"/>
        <Label text="Peer-to-Peer Rental Marketplace" style="-fx-text-fill: #64748b;"/>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
        <VBox spacing="6">
            <Label text="Username" style="-fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Enter your username"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Password" style="-fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Login" onAction="#handleLogin" styleClass="primary-button" maxWidth="Infinity"/>
            <Button text="Register" onAction="#handleRegister" styleClass="secondary-button" maxWidth="Infinity"/>
        </VBox>
    </VBox>
</VBox>
