<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.zugar.controller.RegisterController"
      alignment="CENTER" spacing="16" styleClass="root">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <VBox styleClass="card" maxWidth="400" spacing="14" alignment="CENTER_LEFT">
        <Label text="Create your Zugar Account" styleClass="title-label"/>
        <Label text="Join the Peer-to-Peer Rental Community" style="-fx-text-fill: #64748b;"/>
        <Label fx:id="statusLabel" text="" style="-fx-font-weight: bold;"/>
        <VBox spacing="6">
            <Label text="Username" style="-fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Choose a username"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Password" style="-fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="Choose a password"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Create Account" onAction="#handleRegister" styleClass="primary-button" maxWidth="Infinity"/>
            <Hyperlink text="Already have an account? Login" onAction="#showLogin" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
        </VBox>
    </VBox>
</VBox>
