<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.zugar.controller.MainLayoutController"
            fx:id="mainContainer" styleClass="root">
    <top>
        <HBox styleClass="header-bar" spacing="16">
            <Label text="Zugar" styleClass="brand-label"/>
            <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Button fx:id="catalogNavBtn" text="Catalog" onAction="#showCatalog" styleClass="nav-button"/>
                <Button fx:id="addItemNavBtn" text="+ List Item" onAction="#showAddItem" styleClass="nav-button"/>
                <Button fx:id="requestsNavBtn" text="Requests" onAction="#showRequests" styleClass="nav-button"/>
                <Button fx:id="myItemsNavBtn" text="My Items" onAction="#showMyItems" styleClass="nav-button"/>
            </HBox>
            <Label fx:id="userLabel" text="" style="-fx-text-fill: #e2e8f0; -fx-font-weight: bold;"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
        </HBox>
    </top>
</BorderPane>
